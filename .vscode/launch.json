{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/web",
            "cwd": "${workspaceFolder}",
            "args":[
                "-addr=:4000",
                "-dsn=web:web@/snippetbox?parseTime=true"
            ]
        }
    ]
}